<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core + PostgreSQL (plan §2.2) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Excel čitanje za import komandu (B2) -->
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <!-- Faza 3 — auth: ASP.NET Core Identity nad EF Core + Google OAuth -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.11" />
    <!-- Faza 5 — obrada slika (resize/WebP/žig) + R2 (S3-kompatibilno) storage -->
    <!-- Napomena: SixLabors ImageSharp koristi "Six Labors Split License" (besplatno za OSS/male;
         komercijalna licenca iznad praga). Provjeriti prije komercijalnog lansiranja (v. DEPLOY.md). -->
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.5" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.416.4" />
  </ItemGroup>

</Project>
