# Kopiraj u .env.local (ne commita se).
#
# Faza 2 — izvor podataka za frontend:
#   postavljeno  → /api/* ide na .NET (next.config.mjs rewrites) i server komponente
#                  dohvaćaju s ovog URL-a
#   zakomentirano → mock rute (app/api/*) nad data/vendors.json — rad bez backenda
API_URL=http://localhost:5080

# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zadatak 8 — monitoring. Bez ovoga Sentry se ne inicijalizira (dev ostaje netaknut).
